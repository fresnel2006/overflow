# Configuration Overflow. Copiez ce fichier en "app.env" (meme dossier) puis remplissez.
# app.env est ignore par git : n'y committez jamais de vraies cles.
# Chaque valeur peut aussi etre passee a la compilation : --dart-define=CLE=valeur

# true : donnees fictives d'Abidjan, aucun backend requis.
USE_MOCKS=true

# API FastAPI (sans "/" final). Ex : https://api.overflow.ci/v1
API_BASE_URL=http://10.0.2.2:8000/api/v1
# Rafraichissement des niveaux d'eau, en secondes.
REFRESH_INTERVAL_SECONDS=30
# Source temps reel des capteurs : polling (API) ou firestore (collection "stations").
REALTIME_SOURCE=polling

# Firebase (Auth, Firestore, Storage, FCM). Laissez vide pour le desactiver.
# Valeurs dans la console Firebase > Parametres du projet > Vos applications.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=

# Assistant IA (Gemini). En production, preferez AI_PROXY_URL (route FastAPI qui garde la cle cote serveur).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROXY_URL=
